          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-9" value="OfferReceived / InsurerFailed / RequestFinished&#xa;Из outbox [Kafka/TLS]" edge="1" parent="1" source="osago" target="kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.2;entryX=1;entryY=0.5;">
