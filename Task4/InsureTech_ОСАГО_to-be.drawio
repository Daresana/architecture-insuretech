              <mxPoint x="1090" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-5" value="Результаты: consumer core&#10;[Kafka/TLS]" edge="1" parent="1" source="kafka" target="core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.25;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1550" y="400" />
              <mxPoint x="1550" y="310" />
              <mxPoint x="1040" y="310" />
              <mxPoint x="1040" y="60" />
              <mxPoint x="830" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-6" value="Сигнал после commit&#10;[Pub/Sub]" edge="1" parent="1" source="core" target="redis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=0.85;exitY=1;entryX=0.85;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="Уведомление&#10;[Pub/Sub]" edge="1" parent="1" source="redis" target="core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="RequestOffers&#10;[Kafka/TLS]" edge="1" parent="1" source="kafka" target="osago" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-9" value="OfferReceived / InsurerFailed / RequestFinished&#10;{eventId, requestId, insurerId, status, offer}&#10;из outbox [Kafka/TLS]" edge="1" parent="1" source="osago" target="kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.2;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
