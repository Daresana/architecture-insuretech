              <mxPoint x="1580" y="870" />
              <mxPoint x="1580" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-10" value="Состояние + outbox [SQL]" edge="1" parent="1" source="osago" target="osago-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-11" value="POST /applications&#10;GET /applications/{externalId}/offer&#10;[HTTPS/REST]" edge="1" parent="1" source="osago" target="insurers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-12" value="Общая квота на компанию&#10;для всех экземпляров [Redis/TLS]" edge="1" parent="1" source="osago" target="redis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1090" y="870" />
              <mxPoint x="1090" y="660" />
              <mxPoint x="830" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API браузера&lt;/b&gt;&lt;p&gt;POST /osago/requests — Idempotency-Key; ответ 202 только после сохранения.&lt;/p&gt;&lt;p&gt;GET /osago/requests/{id} — текущий снимок и sequence.&lt;/p&gt;&lt;p&gt;GET /osago/requests/{id}/events — SSE, Last-Event-ID. Повторное подключение получает пропущенные результаты из БД. Доступ только владельцу заявки.&lt;/p&gt;&lt;p&gt;Redis — ускорение уведомлений. Потерянный сигнал подхватывает сверка sequence раз в 2 с; результаты не хранятся только в Pub/Sub.&lt;/p&gt;&lt;p&gt;Команда RequestOffers: requestId, deadlineAt, data (анкета ОСАГО). Ответы связаны через requestId.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="500" height="470" as="geometry" />
        </mxCell>
        <mxCell id="deadline" value="&lt;b&gt;Общий срок — 60 секунд&lt;/b&gt;&lt;p&gt;deadlineAt ставит core при приёме. В него входят очередь, повторы и обращения к компаниям.&lt;/p&gt;&lt;p&gt;Проверка deadline перед каждым вызовом. При истечении — completed с частичным результатом; браузер прекращает ожидание и по своему таймеру. Поздние ответы не меняют завершённую выдачу.&lt;/p&gt;&lt;p&gt;Polling страховщика: раз в 2 с с jitter, только пока результат не готов. Для 2500 заявок × 10 компаний это до 12 500 GET/с: нужны согласованные квоты и нагрузочный тест. Очередь не создаёт пропускную способность.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="940" width="500" height="470" as="geometry" />
        </mxCell>
        <mxCell id="recovery" value="&lt;b&gt;Несколько экземпляров&lt;/b&gt;&lt;p&gt;Внутри группы Kafka команда попадает одному обработчику. В БД уникальны requestId + insurerId, а lease не даёт двум worker одновременно опрашивать одну заявку.&lt;/p&gt;&lt;p&gt;После падения lease истекает; другой worker продолжает по externalId, nextPollAt и deadline. Дубли eventId отбрасываются через inbox.&lt;/p&gt;&lt;p&gt;Все реплики core получают Pub/Sub, но отправляют SSE только своим соединениям. Sticky sessions не нужны.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1710" y="100" width="420" height="500" as="geometry" />
        </mxCell>
        <mxCell id="symbol-0" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota" vertex="1" parent="1">
          <mxGeometry x="1710" y="1030" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-0" value="&lt;b&gt;Timeout&lt;/b&gt;&lt;p&gt;Один HTTP-вызов ≤ min(3 с, остаток deadline).&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1025" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="symbol-1" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=job" vertex="1" parent="1">
          <mxGeometry x="1710" y="1160" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-1" value="&lt;b&gt;Rate Limiter&lt;/b&gt;&lt;p&gt;Общая квота по договору на страховщика; входящий B2B ≤ 20 RPS/партнёр. 429 + Retry-After.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1155" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="symbol-2" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy" vertex="1" parent="1">
          <mxGeometry x="1710" y="1290" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-2" value="&lt;b&gt;Retry&lt;/b&gt;&lt;p&gt;До 2 повторов при временной ошибке; backoff + jitter. POST повторяется только с поддержанным ключом идемпотентности.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1285" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="symbol-3" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=c_role" vertex="1" parent="1">
          <mxGeometry x="1710" y="1420" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-3" value="&lt;b&gt;Circuit Breaker&lt;/b&gt;&lt;p&gt;Отдельно на компанию. Серия ошибок → open; после паузы — half-open. Остальные компании продолжают работу.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1415" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bulkhead" value="Bulkhead: отдельный ограниченный пул и очередь на каждую компанию. Нельзя занять все worker одним медленным страховщиком. Указанные 2 с / 3 с / 2 повтора — стартовые настройки для проверки, не SLA компаний." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="1490" width="1510" height="100" as="geometry" />
        </mxCell>
