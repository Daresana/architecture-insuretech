            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-10" value="Состояние и outbox [SQL]" edge="1" parent="1" source="osago" target="osago-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-11" value="POST /applications&#xa;GET /applications/{externalId}/offer&#xa;[HTTPS/REST]" edge="1" parent="1" source="osago" target="insurers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-12" value="Общая квота страховщика для всех экземпляров [Redis/TLS]" edge="1" parent="1" source="osago" target="redis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1090" y="870" />
              <mxPoint x="1090" y="660" />
              <mxPoint x="830" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API браузера&lt;/b&gt;&lt;p&gt;POST /osago/requests — Idempotency-Key. Ответ 202 с requestId и deadlineAt после сохранения заявки.&lt;/p&gt;&lt;p&gt;GET /osago/requests/{id} — состояние и sequence.&lt;/p&gt;&lt;p&gt;GET /osago/requests/{id}/events — SSE. При переподключении используем Last-Event-ID и выдаём пропущенные результаты из БД.&lt;/p&gt;&lt;p&gt;Доступ есть только у владельца заявки. Каждый ответ страховщика показываем по мере получения.&lt;/p&gt;&lt;p&gt;Redis ускоряет уведомления. Если сигнал потерян, сверяем sequence раз в 2 с и читаем результаты из БД.&lt;/p&gt;&lt;p&gt;RequestOffers: requestId, deadlineAt, data — анкета ОСАГО.&lt;/p&gt;&lt;p&gt;Событие результата: eventId, requestId, insurerId, status, offer.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="500" height="470" as="geometry" />
        </mxCell>
        <mxCell id="deadline" value="&lt;b&gt;Срок ожидания&lt;/b&gt;&lt;p&gt;core-app задаёт deadlineAt при приёме заявки. Общий срок — 60 с, включая очередь, повторы и вызовы страховщиков. Перед каждым вызовом проверяем оставшееся время.&lt;/p&gt;&lt;p&gt;По истечении срока отправляем completed с полученными предложениями. Браузер также останавливает ожидание по своему таймеру. Поздние ответы не меняют завершённую выдачу.&lt;/p&gt;&lt;p&gt;Опрос — раз в 2 с с jitter, пока предложение не готово. Для 2500 заявок и 10 компаний оценка — 12 500 GET/с. Квоты согласуем, нагрузку проверяем тестом. Очередь сама по себе не увеличивает пропускную способность.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="940" width="500" height="470" as="geometry" />
        </mxCell>
        <mxCell id="recovery" value="&lt;b&gt;Несколько экземпляров&lt;/b&gt;&lt;p&gt;Kafka распределяет команды между worker группы osago, результаты — между экземплярами группы core.&lt;/p&gt;&lt;p&gt;Пара requestId + insurerId уникальна. Задание опроса берёт один worker через lease. При его падении lease истекает, другой worker продолжает работу по externalId, nextPollAt и deadline.&lt;/p&gt;&lt;p&gt;Inbox отбрасывает дубли по eventId. Все экземпляры core-app получают Pub/Sub, каждый отправляет SSE своим клиентам. Sticky sessions не требуются.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1710" y="100" width="420" height="500" as="geometry" />
        </mxCell>
        <mxCell id="symbol-0" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota" vertex="1" parent="1">
          <mxGeometry x="1710" y="1030" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-0" value="&lt;b&gt;Timeout&lt;/b&gt;&lt;p&gt;Один HTTP-вызов: min(3 с, оставшееся время).&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1025" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="symbol-1" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=job" vertex="1" parent="1">
          <mxGeometry x="1710" y="1160" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-1" value="&lt;b&gt;Rate Limiter&lt;/b&gt;&lt;p&gt;Общая договорная квота на страховщика. B2B: до 20 RPS на партнёра. Ответ 429 с Retry-After.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1155" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="symbol-2" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy" vertex="1" parent="1">
          <mxGeometry x="1710" y="1290" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-2" value="&lt;b&gt;Retry&lt;/b&gt;&lt;p&gt;До 2 повторов временной ошибки, с backoff и jitter. POST повторяем только при поддержке ключа идемпотентности страховщиком.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1285" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="symbol-3" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=c_role" vertex="1" parent="1">
          <mxGeometry x="1710" y="1420" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pattern-3" value="&lt;b&gt;Circuit Breaker&lt;/b&gt;&lt;p&gt;Отдельно для каждой компании. При серии ошибок — open. После паузы — пробные вызовы в half-open. Остальные компании продолжают работу.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1780" y="1415" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bulkhead" value="Bulkhead&#xa;У каждой компании свой пул worker и своя очередь. Их размеры ограничены. Медленный страховщик не занимает все worker.&#xa;2 с, 3 с и 2 повтора — стартовые настройки для теста. Это не SLA страховщиков." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="1490" width="1510" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
