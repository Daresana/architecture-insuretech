          <mxGeometry x="1650" y="950" width="510" height="145" as="geometry" />
        </mxCell>
        <mxCell id="edge-11" value="WAL streaming&#10;синхронное подтверждение от 1 из 2 standby" edge="1" parent="1" source="pg-a" target="pg-b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="415" y="1260" />
              <mxPoint x="1205" y="1260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-12" value="WAL; второй standby&#10;Patroni synchronous quorum" edge="1" parent="1" source="pg-a" target="third" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="1135" />
              <mxPoint x="30" y="1325" />
              <mxPoint x="2200" y="1325" />
              <mxPoint x="2200" y="1020" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="backup" value="pgBackRest → Object Storage&#10;Full backup ежедневно + непрерывный WAL&#10;archive_timeout=60 с; отдельные credentials&#10;PITR; копия вне основной площадки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=18;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1650" y="1150" width="510" height="170" as="geometry" />
        </mxCell>
        <mxCell id="backup-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml," vertex="1" parent="1">
          <mxGeometry x="1600" y="1190" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="edge-13" value="Backup / WAL&#10;при смене primary — переназначение" edge="1" parent="1" source="pg-b" target="backup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#333333;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;Масштабирование и отказ&lt;/b&gt;&lt;p&gt;Приложение — Active–Active. Каждая площадка выдерживает весь пик при отказе второй; ёмкость подтверждается нагрузочным тестом.&lt;/p&gt;&lt;p&gt;Кластеры независимые: отказ control-plane и обновление не затрагивают вторую площадку. WAN не входит в кворум Kubernetes.&lt;/p&gt;&lt;p&gt;Сессии не привязаны к памяти pod. readiness /ready и liveness /live — каждые 10 с; startupProbe — для запуска.&lt;/p&gt;&lt;p&gt;Вертикально увеличиваем ресурсы БД после анализа запросов и индексов. Шардирование не нужно: 50 GB и заданная нагрузка его не обосновывают.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1650" y="380" width="510" height="520" as="geometry" />
        </mxCell>
        <mxCell id="recovery" value="&lt;b&gt;Failover клиента и БД&lt;/b&gt;&lt;p&gt;GSLB исключает отказавшую площадку; клиент переподключается к здоровой. POST — с ключом идемпотентности. Для зависших запросов — timeout.&lt;/p&gt;&lt;p&gt;Patroni выбирает актуальную реплику; fencing исключает старый primary. HAProxy проверяет /primary, пулы повторно открывают соединения. Без безопасного кворума запись останавливается.&lt;/p&gt;&lt;p&gt;Синхронная репликация защищает подтверждённые записи. Потеря всех узлов: восстановление backup + WAL, PITR. Проверяем восстановление 50 GB и переключение на учениях: цели RTO/RPO не доказаны одной схемой.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1380" width="1010" height="290" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;Контроль и география&lt;/b&gt;&lt;p&gt;Prometheus + Alertmanager: внешний /ready из регионов, p95/p99, ошибки, saturation, replication lag, возраст backup/WAL, свободная память/диск. Оповещение дежурного.&lt;/p&gt;&lt;p&gt;CDN сокращает задержку статических страниц, GeoDNS ведёт на ближайшее приложение. Полное равенство времени через разные сети не гарантируется; динамические записи зависят от RTT до primary.&lt;/p&gt;&lt;p&gt;Перед внедрением уточнить допустимую разницу p95 между регионами и выбрать реальные площадки/провайдеров по замерам. Иконки Yandex Cloud используются как нотация, не как утверждение о географии его регионов.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1380" width="1020" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>